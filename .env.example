# Copy to .env (gitignored) and fill in. NEVER commit real values.
# In Azure these all come from Key Vault via managed identity — see ARCHITECTURE.md §16.

# ── Core ───────────────────────────────────────────────────────────────────
ARGUS_ENV=local
ARGUS_LOG_LEVEL=INFO
ARGUS_LOG_JSON=false

# ── Postgres (OLTP + pgvector + LangGraph checkpoints) ─────────────────────
ARGUS_POSTGRES_DSN=postgresql+asyncpg://argus:argus@localhost:5432/argus

# ── Event bus (Redpanda locally, Event Hubs in cloud — same Kafka client) ──
ARGUS_KAFKA_BOOTSTRAP=localhost:9092

# ── Trust plane ────────────────────────────────────────────────────────────
ARGUS_OPENFGA_URL=http://localhost:8080
ARGUS_OPENFGA_STORE_ID=
ARGUS_OPA_URL=http://localhost:8181

# ── Ops plane ──────────────────────────────────────────────────────────────
ARGUS_OTEL_ENDPOINT=http://localhost:4317
ARGUS_PROMETHEUS_PUSHGATEWAY=http://localhost:9091
ARGUS_MLFLOW_TRACKING_URI=http://localhost:5000

# ── LLM provider ───────────────────────────────────────────────────────────
# Copy this file to `.env` (gitignored) and fill in a key. With no key at all the
# service still starts and every path still runs — it falls back to EchoProvider and
# says so on /healthz. That is deliberate: a demo that needs a credential is a demo
# that breaks the morning the key rotates.
#
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

ARGUS_AZURE_OPENAI_ENDPOINT=
ARGUS_AZURE_OPENAI_API_KEY=

# Google retires model ids. If every request starts degrading with `provider_error`,
# check the service log — a 404 here names its own replacement.
ARGUS_LLM_MODEL=gemini-3.5-flash-lite

# Reasoning models spend thinking tokens from this budget before emitting the first
# answer token, so this is not just "how long may the answer be". Too low and you get
# `output_truncated`: a well-formed empty response.
ARGUS_MAX_OUTPUT_TOKENS=2048

# Fails closed on cost. The gateway reserves against an estimate BEFORE each call, so
# an agent in a retry loop stops rather than discovering the bill later.
ARGUS_DAILY_BUDGET_USD=2.0

# ── Simulator ──────────────────────────────────────────────────────────────
ARGUS_SIM_SEED=42
